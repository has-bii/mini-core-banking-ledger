# The API and seeder load .env from the working directory automatically.
# Existing environment variables take precedence.
APP_ENV="dev"
HTTP_ADDR=":8080"
DATABASE_URL="postgresql://user:password@localhost:5432/postgres"
LOG_LEVEL="info"
HTTP_READ_TIMEOUT="5s"
SHUTDOWN_TIMEOUT="10s"

# Development seeder: go run ./cmd/seed (APP_ENV must be dev).
# Required for seeding; 8–72 bytes. Use only with a development database.
SEED_PASSWORD="password123"

# Optional migrated, disposable database for integration tests.
# TEST_DATABASE_URL="postgresql://user:password@localhost:5432/ledger_test"

# GOOSE
GOOSE_DRIVER="postgres"
GOOSE_DBSTRING="postgresql://user:password@localhost:5432/postgres"
GOOSE_MIGRATION_DIR="migrations"
